<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allow http:// so the app can reach the local server
     (emulator: 10.0.2.2, phone: your laptop's LAN IP). Release uses
     src/main/res/xml/network_security_config.xml, which forbids it. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
