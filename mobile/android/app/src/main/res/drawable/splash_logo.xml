        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="48"
                android:endX="96"
                android:endY="48"
                android:startColor="#FF8B82FF"
                android:endColor="#FF5CC4FF" />
        </aapt:attr>
    </path>
    <path
        android:pathData="M48,25L67,32L67,47C67,59 59,68 48,72C37,68 29,59 29,47L29,32Z"
