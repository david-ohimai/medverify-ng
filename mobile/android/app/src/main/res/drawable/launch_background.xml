<?xml version="1.0" encoding="utf-8"?>
<!-- Shown by Android (before 12) the moment the app is tapped, until Flutter
     draws its first frame: brand navy with the logo in the centre, exactly
     where SplashScreen draws it, so the splash never starts on a blank screen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
    <item
        android:width="96dp"
        android:height="96dp"
        android:drawable="@drawable/splash_logo"
        android:gravity="center" />
</layer-list>
