{
  "name": "medverify-server",
  "version": "0.1.0",
  "private": true,
  "description": "MedVerify NG API - verify a medicine before you take it.",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "worker:dev": "tsx watch src/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d --build",
    "db:stop": "docker compose stop",
    "db:wipe": "docker compose down -v",
    "db:psql": "docker exec -it medverify-db psql -U medverify -d medverify",
    "redis:cli": "docker exec -it medverify-redis redis-cli",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "prisma:studio": "prisma studio --port 5555",
    "prisma:reset": "prisma migrate reset --force",
    "seed": "tsx prisma/seed.ts",
    "smoke": "bash scripts/smoke-test.sh",
    "eval": "tsx scripts/eval.ts",
    "eval:agent": "tsx scripts/eval-agent.ts",
    "eval:rag": "tsx scripts/eval-rag.ts",
    "eval:report": "tsx scripts/eval-report.ts",
    "simulate": "tsx scripts/simulate-scans.ts",
    "kb:fetch": "tsx scripts/kb-fetch.ts",
    "kb:ingest": "tsx scripts/kb-ingest.ts",
    "demo-images": "tsx scripts/generate-demo-images.ts"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "^6.4.0",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "openai": "^7.45.1",
    "opossum": "^10.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^6.0.1",
    "sharp": "^0.35.5",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "xss": "^1.0.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mozilla/readability": "^0.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/opossum": "^8.1.9",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/turndown": "^5.0.6",
    "linkedom": "^0.18.14",
    "pino-pretty": "^13.2.0",
    "prisma": "7.10.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "turndown": "^7.2.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
