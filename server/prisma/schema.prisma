// MedVerify NG database schema.
// After editing: npm run prisma:migrate -- --name <what_changed>  then  npm run prisma:generate

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
  previewFeatures        = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // postgis: hotspot clustering · vector: embeddings (RAG, fuzzy names) · pg_trgm: fuzzy text search
  extensions = [postgis, vector, pg_trgm]
}

enum DevicePlatform {
  android
  ios
}

enum DeviceRole {
  public
  regulator
}

/// en = English, pcm = Nigerian Pidgin, ha = Hausa, yo = Yoruba, ig = Igbo
enum AppLanguage {
  en
  pcm
  ha
  yo
  ig
}

enum TokenRevokeReason {
  /// Replaced by a newer token in the same chain (normal refresh).
  rotated
  /// Every session ended: re-registration, role change or "delete my data".
  session_reset
  /// The chain was killed because a rotated token was presented again.
  reuse_detected
}

/// NAFDAC registration status of a product.
enum ProductStatus {
  active
  expired
  cancelled
}

/// Where a registry row came from. `demo` rows are fictional placeholders
/// for development and tests, never presented as real NAFDAC data.
enum RegistrySource {
  greenbook
  pack_label
  nafdac_alert
  demo
}

enum ScanKind {
  /// Typed-in NAFDAC number / batch: registry rules only, no AI.
  manual
  /// Pack photo: AI reads and compares the pack, then the same rules run.
  photo
}

/// A photo scan is accepted at once (pending) and processed by the queue
/// worker. Manual checks are created already `done`.
enum ScanStatus {
  pending
  processing
  done
  failed
}

enum Verdict {
  likely_genuine
  suspicious
  high_risk
  unregistered
}

enum Confidence {
  high
  medium
  low
}

/// One installed copy of the app. There are no user accounts: the device is the identity.
model Device {
  id            String         @id @default(uuid()) @db.Uuid
  /// SHA-256 of the random install id the app generates. The raw id is never stored.
  installIdHash String         @unique @map("install_id_hash") @db.Char(64)
  platform      DevicePlatform
  appVersion    String         @map("app_version") @db.VarChar(20)
  language      AppLanguage    @default(en)
  role          DeviceRole     @default(public)
  /// Bumped whenever the device's role or session changes. Access tokens carry
  /// it, and a token with an older version is rejected immediately.
  tokenVersion  Int            @default(1) @map("token_version")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt    DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  scans         Scan[]
  conversations AssistantConversation[]

  @@map("devices")
}

/// Rotating refresh tokens, stored as SHA-256 hashes. Every token in a login
/// chain shares a familyId so a reused (stolen) token can revoke the whole chain.
model RefreshToken {
  id            String             @id @default(uuid()) @db.Uuid
  deviceId      String             @map("device_id") @db.Uuid
  tokenHash     String             @unique @map("token_hash") @db.Char(64)
  familyId      String             @map("family_id") @db.Uuid
  expiresAt     DateTime           @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime?          @map("revoked_at") @db.Timestamptz(3)
  /// Why it stopped working. Only a token revoked by `rotated` coming back
  /// means theft; one ended by a session reset is just stale.
  revokedReason TokenRevokeReason? @map("revoked_reason")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Append-only record of security-relevant actions, written by event listeners.
model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  deviceId      String?  @map("device_id") @db.Uuid
  action        String   @db.VarChar(64)
  entity        String?  @db.VarChar(64)
  entityId      String?  @map("entity_id") @db.VarChar(64)
  meta          Json     @default("{}")
  correlationId String?  @map("correlation_id") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([deviceId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// A registered medicine (one NAFDAC registration number).
model Product {
  id           String         @id @default(uuid()) @db.Uuid
  /// Normalised: upper case, ASCII hyphen, no spaces, e.g. "A4-1234".
  nafdacNo     String         @unique @map("nafdac_no") @db.VarChar(20)
  brandName    String         @map("brand_name") @db.VarChar(120)
  genericName  String         @map("generic_name") @db.VarChar(200)
  strength     String?        @db.VarChar(80)
  dosageForm   String?        @map("dosage_form") @db.VarChar(60)
  manufacturer String?        @db.VarChar(160)
  status       ProductStatus  @default(active)
  source       RegistrySource
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  batches         Batch[]
  scans           Scan[]
  referenceImages ReferenceImage[]
  hotspots        Hotspot[]

  // Fuzzy name search ("C0artem" still finds Coartem) with pg_trgm.
  @@index([brandName(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_brand_name_trgm_idx")
  @@index([genericName(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_generic_name_trgm_idx")
  @@map("products")
}

/// A manufacturing batch of a product, as known to the registry (from packs,
/// manufacturers or NAFDAC recall alerts). The registry will never know every
/// batch, so an unknown batch lowers confidence rather than raising risk.
model Batch {
  id         String         @id @default(uuid()) @db.Uuid
  productId  String         @map("product_id") @db.Uuid
  /// Normalised: upper case, no spaces.
  batchNo    String         @map("batch_no") @db.VarChar(40)
  mfgDate    DateTime?      @map("mfg_date") @db.Date
  expiryDate DateTime?      @map("expiry_date") @db.Date
  recalled   Boolean        @default(false)
  recallNote String?        @map("recall_note") @db.Text
  source     RegistrySource
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, batchNo])
  @@map("batches")
}

enum PackSide {
  front
  back
  other
}

/// A photo of the GENUINE pack, used by the AI to compare a scanned pack
/// against. Stored in the database (re-encoded JPEG, ~100–200 kB) so the
/// registry, its batches and its reference photos travel together, no
/// bucket or CDN account needed. Loaded from prisma/seed/reference/.
model ReferenceImage {
  id        String         @id @default(uuid()) @db.Uuid
  productId String         @map("product_id") @db.Uuid
  side      PackSide
  /// Re-encoded JPEG, metadata stripped.
  data      Bytes
  width     Int
  height    Int
  /// SHA-256 of the source file: the seed uses it to add, keep or remove photos.
  sha256    String         @unique @db.Char(64)
  /// Where it came from, e.g. "prisma/seed/reference/A4-1234/front-1.jpg".
  fileName  String         @map("file_name") @db.VarChar(200)
  source    RegistrySource
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, side])
  @@map("reference_images")
}

/// Every verification, typed in or photographed, with its verdict and the
/// signals that explain it. Deleting a device keeps its scans for the
/// hotspot map but removes the link to the device.
model Scan {
  id          String      @id @default(uuid()) @db.Uuid
  deviceId    String?     @map("device_id") @db.Uuid
  kind        ScanKind
  status      ScanStatus  @default(done)
  /// What the user entered or the AI read from the pack, normalised.
  nafdacNo    String?     @map("nafdac_no") @db.VarChar(20)
  productName String?     @map("product_name") @db.VarChar(200)
  batchNo     String?     @map("batch_no") @db.VarChar(40)
  expiryDate  DateTime?   @map("expiry_date") @db.Date
  productId   String?     @map("product_id") @db.Uuid
  /// Verdict, score and confidence are null until a photo scan is done.
  verdict     Verdict?
  /// 0 (no concerns) to 100 (highest risk).
  riskScore   Int?        @map("risk_score") @db.SmallInt
  confidence  Confidence?
  /// The explainable reasons: [{ code, label, weight, detail }].
  signals     Json        @default("[]")
  /// SHA-256 of the uploaded photo. The photo itself isn't kept, unless the scan is queued for human review (scan_reviews).
  imageHash   String?     @map("image_hash") @db.Char(64)
  /// Everything the AI read from the label, with per-field confidence.
  extracted   Json?
  /// Why a photo scan couldn't produce a verdict (e.g. NAFDAC_NO_UNREADABLE).
  failureCode String?     @map("failure_code") @db.VarChar(40)
  /// Which AI provider read the pack (gemini / openrouter / cache).
  llmProvider String?     @map("llm_provider") @db.VarChar(20)
  /// Where the scan happened, rounded to 2 decimals (~1 km) before it is
  /// stored, never the exact spot. Optional: the app asks permission.
  latitude    Float?      @db.DoublePrecision
  longitude   Float?      @db.DoublePrecision
  /// Nearest known market or area, when within a few km (lib/areas.ts).
  areaName    String?     @map("area_name") @db.VarChar(80)
  /// Generated pilot data (npm run simulate). Always flagged in the API.
  simulated   Boolean     @default(false)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt DateTime?   @map("completed_at") @db.Timestamptz(3)

  device      Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  product     Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  aiAuditLogs AiAuditLog[]
  review      ScanReview?

  @@index([deviceId, createdAt(sort: Desc)])
  @@index([nafdacNo, batchNo])
  /// Hotspot clustering and stats read recent scans by time.
  @@index([createdAt(sort: Desc), riskScore])
  @@map("scans")
}

enum HotspotSeverity {
  low
  medium
  high
}

/// A cluster of suspicious scans close together in place and time, found by
/// PostGIS ST_ClusterDBSCAN over the last 7 days (refreshed by a BullMQ job).
/// A cluster that disappears is kept, inactive, for the record.
model Hotspot {
  id             String          @id @default(uuid()) @db.Uuid
  latitude       Float           @db.DoublePrecision
  longitude      Float           @db.DoublePrecision
  /// Distance from the centre to the farthest scan in the cluster.
  radiusM        Int             @map("radius_m")
  scanCount      Int             @map("scan_count")
  highRiskCount  Int             @map("high_risk_count")
  maxRiskScore   Int             @map("max_risk_score")
  recallInvolved Boolean         @map("recall_involved")
  severity       HotspotSeverity
  /// The product and batch most of the cluster's scans were about.
  productId      String?         @map("product_id") @db.Uuid
  nafdacNo       String?         @map("nafdac_no") @db.VarChar(20)
  batchNo        String?         @map("batch_no") @db.VarChar(40)
  areaName       String?         @map("area_name") @db.VarChar(80)
  /// Share of the cluster's scans that are simulated pilot data (0–1).
  simulatedShare Float           @map("simulated_share")
  firstSeen      DateTime        @map("first_seen") @db.Timestamptz(3)
  lastSeen       DateTime        @map("last_seen") @db.Timestamptz(3)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  alerts  HotspotAlert[]

  @@index([active, severity])
  @@map("hotspots")
}

/// The alert card regulators read: written by the AI from the cluster's
/// facts only (or from a template if the AI is unavailable). A new alert is
/// written only when a hotspot appears or grows, so it costs little quota.
model HotspotAlert {
  id                String          @id @default(uuid()) @db.Uuid
  hotspotId         String          @map("hotspot_id") @db.Uuid
  title             String          @db.VarChar(120)
  body              String          @db.VarChar(600)
  recommendedAction String          @map("recommended_action") @db.VarChar(300)
  severity          HotspotSeverity
  /// gemini / openrouter / template
  generatedBy       String          @map("generated_by") @db.VarChar(20)
  promptVersion     Int?            @map("prompt_version")
  /// The exact facts the alert was written from, nothing else was given to the AI.
  facts             Json
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  hotspot Hotspot @relation(fields: [hotspotId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@map("hotspot_alerts")
}

/// An official page the assistant may quote (WHO or NAFDAC only, see
/// src/lib/verifiedSources.ts). Loaded from kb/documents/ by npm run kb:ingest.
model KbDocument {
  id        String   @id @db.VarChar(80)
  title     String   @db.VarChar(300)
  publisher String   @db.VarChar(80)
  url       String   @db.VarChar(500)
  /// When the page was downloaded from its official site.
  retrieved DateTime @db.Date
  /// Hash of the document text: unchanged documents aren't re-embedded.
  sha256    String   @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  chunks KbChunk[]

  @@map("kb_documents")
}

/// One passage of a document with its embedding (pgvector). The knowledge
/// base is a few hundred chunks, so search is an exact scan, an HNSW index
/// only pays off at tens of thousands of rows.
model KbChunk {
  id         String                      @id @default(uuid()) @db.Uuid
  documentId String                      @map("document_id") @db.VarChar(80)
  position   Int
  /// Nearest heading above the passage.
  section    String?                     @db.VarChar(300)
  content    String                      @db.Text
  /// gemini-embedding-001, 768 dimensions, normalised.
  embedding  Unsupported("vector(768)")?

  document KbDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, position])
  @@map("kb_chunks")
}

/// One chat with the assistant. Its role is fixed when it starts, so a
/// conversation can't gain regulator tools later.
model AssistantConversation {
  id        String     @id @default(uuid()) @db.Uuid
  deviceId  String?    @map("device_id") @db.Uuid
  role      DeviceRole
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  device   Device?            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  messages AssistantMessage[]

  @@index([deviceId, updatedAt(sort: Desc)])
  @@map("assistant_conversations")
}

enum AssistantMessageRole {
  user
  assistant
  tool
}

/// The conversation and its execution trace: every tool call, its
/// validated arguments and a summary of what it returned.
model AssistantMessage {
  id                String               @id @default(uuid()) @db.Uuid
  conversationId    String               @map("conversation_id") @db.Uuid
  role              AssistantMessageRole
  content           String               @db.Text
  toolName          String?              @map("tool_name") @db.VarChar(60)
  toolArgs          Json?                @map("tool_args")
  toolResultSummary String?              @map("tool_result_summary") @db.VarChar(1000)
  /// For assistant answers: the sources cited [{ title, url, publisher }].
  citations         Json?
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("assistant_messages")
}

enum ReviewStatus {
  /// Waiting for a reviewer.
  open
  /// A reviewer is working on it (the claim lapses after an hour).
  claimed
  decided
}

enum ReviewDecision {
  /// The reviewer agrees with the AI-assisted verdict.
  agree
  /// The reviewer sets a different verdict.
  disagree
  /// The photo can't settle it (blurry, wrong side): ask the user to rescan or visit a pharmacist.
  inconclusive
}

/// Human in the loop: a photo scan the system isn't sure about, or that
/// says "don't take it", waits here for a pharmacist / NAFDAC reviewer
/// (regulator mode). The photo is kept only while the review is open,
/// at most 7 days, then deleted.
model ScanReview {
  id              String          @id @default(uuid()) @db.Uuid
  scanId          String          @unique @map("scan_id") @db.Uuid
  status          ReviewStatus    @default(open)
  /// 1 = urgent (says don't take it), 2 = suspicious, 3 = "genuine" but unsure.
  priority        Int             @db.SmallInt
  /// Why it was queued, e.g. ["HIGH_RISK"], ["LOW_CONFIDENCE_GENUINE", "POOR_IMAGE"].
  reasons         String[]
  slaDeadline     DateTime        @map("sla_deadline") @db.Timestamptz(3)
  /// How many times it has missed its deadline (each miss escalates it).
  escalationLevel Int             @default(0) @map("escalation_level") @db.SmallInt
  /// The pack photo (re-encoded JPEG), deleted when decided or after 7 days.
  imageData       Bytes?          @map("image_data")
  claimedBy       String?         @map("claimed_by") @db.Uuid
  claimedAt       DateTime?       @map("claimed_at") @db.Timestamptz(3)
  decision        ReviewDecision?
  /// For "disagree": the verdict the reviewer sets.
  reviewedVerdict Verdict?        @map("reviewed_verdict")
  /// Shown to the user with their scan.
  reviewerNote    String?         @map("reviewer_note") @db.VarChar(500)
  decidedBy       String?         @map("decided_by") @db.Uuid
  decidedAt       DateTime?       @map("decided_at") @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([status, priority, slaDeadline])
  @@map("scan_reviews")
}

/// Model control plane: every prompt the AI uses is a numbered version.
/// Exactly one version per task is active; changing a prompt is a new row
/// plus an activation, never a redeploy, and old versions stay for audits.
model PromptVersion {
  id        String   @id @default(uuid()) @db.Uuid
  /// e.g. "read_label", "compare_pack"
  task      String   @db.VarChar(40)
  version   Int
  system    String   @db.Text
  notes     String?  @db.Text
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([task, version])
  @@map("prompt_versions")
}

/// One row per AI call: who answered, with which model and prompt version,
/// how long it took and how many tokens it used. Inputs are summarised and
/// never contain images or personal data.
model AiAuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  task          String   @db.VarChar(40)
  provider      String   @db.VarChar(20)
  model         String   @db.VarChar(80)
  promptVersion Int?     @map("prompt_version")
  success       Boolean
  /// Why it failed (RATE_LIMITED, TIMEOUT, INVALID_OUTPUT, …).
  errorCode     String?  @map("error_code") @db.VarChar(40)
  /// True when the primary provider failed and this one answered instead.
  fallbackUsed  Boolean  @default(false) @map("fallback_used")
  inputSummary  String   @map("input_summary") @db.VarChar(500)
  outputSummary String?  @map("output_summary") @db.VarChar(1000)
  inputTokens   Int?     @map("input_tokens")
  outputTokens  Int?     @map("output_tokens")
  latencyMs     Int      @map("latency_ms")
  scanId        String?  @map("scan_id") @db.Uuid
  correlationId String?  @map("correlation_id") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  scan Scan? @relation(fields: [scanId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([task, createdAt(sort: Desc)])
  @@index([scanId])
  @@map("ai_audit_logs")
}
