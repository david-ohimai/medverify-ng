// MedVerify NG database schema.
// After editing: npm run prisma:migrate -- --name <what_changed>  then  npm run prisma:generate

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
  previewFeatures        = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // postgis: hotspot clustering · vector: embeddings (RAG, fuzzy names) · pg_trgm: fuzzy text search
  extensions = [postgis, vector, pg_trgm]
}

enum DevicePlatform {
  android
  ios
}

enum DeviceRole {
  public
  regulator
}

/// en = English, pcm = Nigerian Pidgin, ha = Hausa, yo = Yoruba, ig = Igbo
enum AppLanguage {
  en
  pcm
  ha
  yo
  ig
}

enum TokenRevokeReason {
  /// Replaced by a newer token in the same chain (normal refresh).
  rotated
  /// Every session ended: re-registration, role change or "delete my data".
  session_reset
  /// The chain was killed because a rotated token was presented again.
  reuse_detected
}

/// NAFDAC registration status of a product.
enum ProductStatus {
  active
  expired
  cancelled
}

/// Where a registry row came from. `demo` rows are fictional placeholders
/// for development and tests — never presented as real NAFDAC data.
enum RegistrySource {
  greenbook
  pack_label
  nafdac_alert
  demo
}

enum ScanKind {
  /// Typed-in NAFDAC number / batch: registry rules only, no AI.
  manual
  /// Pack photo: AI reads and compares the pack, then the same rules run.
  photo
}

/// A photo scan is accepted at once (pending) and processed by the queue
/// worker. Manual checks are created already `done`.
enum ScanStatus {
  pending
  processing
  done
  failed
}

enum Verdict {
  likely_genuine
  suspicious
  high_risk
  unregistered
}

enum Confidence {
  high
  medium
  low
}

/// One installed copy of the app. There are no user accounts: the device is the identity.
model Device {
  id            String         @id @default(uuid()) @db.Uuid
  /// SHA-256 of the random install id the app generates. The raw id is never stored.
  installIdHash String         @unique @map("install_id_hash") @db.Char(64)
  platform      DevicePlatform
  appVersion    String         @map("app_version") @db.VarChar(20)
  language      AppLanguage    @default(en)
  role          DeviceRole     @default(public)
  /// Bumped whenever the device's role or session changes. Access tokens carry
  /// it, and a token with an older version is rejected immediately.
  tokenVersion  Int            @default(1) @map("token_version")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt    DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  scans         Scan[]

  @@map("devices")
}

/// Rotating refresh tokens, stored as SHA-256 hashes. Every token in a login
/// chain shares a familyId so a reused (stolen) token can revoke the whole chain.
model RefreshToken {
  id            String             @id @default(uuid()) @db.Uuid
  deviceId      String             @map("device_id") @db.Uuid
  tokenHash     String             @unique @map("token_hash") @db.Char(64)
  familyId      String             @map("family_id") @db.Uuid
  expiresAt     DateTime           @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime?          @map("revoked_at") @db.Timestamptz(3)
  /// Why it stopped working. Only a token revoked by `rotated` coming back
  /// means theft; one ended by a session reset is just stale.
  revokedReason TokenRevokeReason? @map("revoked_reason")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Append-only record of security-relevant actions, written by event listeners.
model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  deviceId      String?  @map("device_id") @db.Uuid
  action        String   @db.VarChar(64)
  entity        String?  @db.VarChar(64)
  entityId      String?  @map("entity_id") @db.VarChar(64)
  meta          Json     @default("{}")
  correlationId String?  @map("correlation_id") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([deviceId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// A registered medicine (one NAFDAC registration number).
model Product {
  id           String         @id @default(uuid()) @db.Uuid
  /// Normalised: upper case, ASCII hyphen, no spaces — e.g. "A4-1234".
  nafdacNo     String         @unique @map("nafdac_no") @db.VarChar(20)
  brandName    String         @map("brand_name") @db.VarChar(120)
  genericName  String         @map("generic_name") @db.VarChar(200)
  strength     String?        @db.VarChar(80)
  dosageForm   String?        @map("dosage_form") @db.VarChar(60)
  manufacturer String?        @db.VarChar(160)
  status       ProductStatus  @default(active)
  source       RegistrySource
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  batches         Batch[]
  scans           Scan[]
  referenceImages ReferenceImage[]

  // Fuzzy name search ("C0artem" still finds Coartem) with pg_trgm.
  @@index([brandName(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_brand_name_trgm_idx")
  @@index([genericName(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_generic_name_trgm_idx")
  @@map("products")
}

/// A manufacturing batch of a product, as known to the registry (from packs,
/// manufacturers or NAFDAC recall alerts). The registry will never know every
/// batch, so an unknown batch lowers confidence rather than raising risk.
model Batch {
  id         String         @id @default(uuid()) @db.Uuid
  productId  String         @map("product_id") @db.Uuid
  /// Normalised: upper case, no spaces.
  batchNo    String         @map("batch_no") @db.VarChar(40)
  mfgDate    DateTime?      @map("mfg_date") @db.Date
  expiryDate DateTime?      @map("expiry_date") @db.Date
  recalled   Boolean        @default(false)
  recallNote String?        @map("recall_note") @db.Text
  source     RegistrySource
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, batchNo])
  @@map("batches")
}

enum PackSide {
  front
  back
  other
}

/// A photo of the GENUINE pack, used by the AI to compare a scanned pack
/// against. Stored in the database (re-encoded JPEG, ~100–200 kB) so the
/// registry, its batches and its reference photos travel together — no
/// bucket or CDN account needed. Loaded from prisma/seed/reference/.
model ReferenceImage {
  id        String         @id @default(uuid()) @db.Uuid
  productId String         @map("product_id") @db.Uuid
  side      PackSide
  /// Re-encoded JPEG, metadata stripped.
  data      Bytes
  width     Int
  height    Int
  /// SHA-256 of the source file: the seed uses it to add, keep or remove photos.
  sha256    String         @unique @db.Char(64)
  /// Where it came from, e.g. "prisma/seed/reference/A4-1234/front-1.jpg".
  fileName  String         @map("file_name") @db.VarChar(200)
  source    RegistrySource
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, side])
  @@map("reference_images")
}

/// Every verification — typed in or photographed — with its verdict and the
/// signals that explain it. Deleting a device keeps its scans for the
/// hotspot map but removes the link to the device.
model Scan {
  id          String      @id @default(uuid()) @db.Uuid
  deviceId    String?     @map("device_id") @db.Uuid
  kind        ScanKind
  status      ScanStatus  @default(done)
  /// What the user entered or the AI read from the pack, normalised.
  nafdacNo    String?     @map("nafdac_no") @db.VarChar(20)
  productName String?     @map("product_name") @db.VarChar(200)
  batchNo     String?     @map("batch_no") @db.VarChar(40)
  expiryDate  DateTime?   @map("expiry_date") @db.Date
  productId   String?     @map("product_id") @db.Uuid
  /// Verdict, score and confidence are null until a photo scan is done.
  verdict     Verdict?
  /// 0 (no concerns) to 100 (highest risk).
  riskScore   Int?        @map("risk_score") @db.SmallInt
  confidence  Confidence?
  /// The explainable reasons: [{ code, label, weight, detail }].
  signals     Json        @default("[]")
  /// SHA-256 of the uploaded photo. The photo itself is never stored.
  imageHash   String?     @map("image_hash") @db.Char(64)
  /// Everything the AI read from the label, with per-field confidence.
  extracted   Json?
  /// Why a photo scan couldn't produce a verdict (e.g. NAFDAC_NO_UNREADABLE).
  failureCode String?     @map("failure_code") @db.VarChar(40)
  /// Which AI provider read the pack (gemini / openrouter / cache).
  llmProvider String?     @map("llm_provider") @db.VarChar(20)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt DateTime?   @map("completed_at") @db.Timestamptz(3)

  device      Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  product     Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  aiAuditLogs AiAuditLog[]

  @@index([deviceId, createdAt(sort: Desc)])
  @@index([nafdacNo, batchNo])
  @@map("scans")
}

/// Model control plane: every prompt the AI uses is a numbered version.
/// Exactly one version per task is active; changing a prompt is a new row
/// plus an activation, never a redeploy, and old versions stay for audits.
model PromptVersion {
  id        String   @id @default(uuid()) @db.Uuid
  /// e.g. "read_label", "compare_pack"
  task      String   @db.VarChar(40)
  version   Int
  system    String   @db.Text
  notes     String?  @db.Text
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([task, version])
  @@map("prompt_versions")
}

/// One row per AI call: who answered, with which model and prompt version,
/// how long it took and how many tokens it used. Inputs are summarised and
/// never contain images or personal data.
model AiAuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  task          String   @db.VarChar(40)
  provider      String   @db.VarChar(20)
  model         String   @db.VarChar(80)
  promptVersion Int?     @map("prompt_version")
  success       Boolean
  /// Why it failed (RATE_LIMITED, TIMEOUT, INVALID_OUTPUT, …).
  errorCode     String?  @map("error_code") @db.VarChar(40)
  /// True when the primary provider failed and this one answered instead.
  fallbackUsed  Boolean  @default(false) @map("fallback_used")
  inputSummary  String   @map("input_summary") @db.VarChar(500)
  outputSummary String?  @map("output_summary") @db.VarChar(1000)
  inputTokens   Int?     @map("input_tokens")
  outputTokens  Int?     @map("output_tokens")
  latencyMs     Int      @map("latency_ms")
  scanId        String?  @map("scan_id") @db.Uuid
  correlationId String?  @map("correlation_id") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  scan Scan? @relation(fields: [scanId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([task, createdAt(sort: Desc)])
  @@index([scanId])
  @@map("ai_audit_logs")
}
