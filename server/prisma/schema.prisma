// MedVerify NG database schema.
// After editing: npm run prisma:migrate -- --name <what_changed>  then  npm run prisma:generate

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
  previewFeatures        = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // postgis: hotspot clustering · vector: embeddings (RAG, fuzzy names) · pg_trgm: fuzzy text search
  extensions = [postgis, vector, pg_trgm]
}

enum DevicePlatform {
  android
  ios
}

enum DeviceRole {
  public
  regulator
}

/// en = English, pcm = Nigerian Pidgin, ha = Hausa, yo = Yoruba, ig = Igbo
enum AppLanguage {
  en
  pcm
  ha
  yo
  ig
}

/// One installed copy of the app. There are no user accounts: the device is the identity.
model Device {
  id            String         @id @default(uuid()) @db.Uuid
  /// SHA-256 of the random install id the app generates. The raw id is never stored.
  installIdHash String         @unique @map("install_id_hash") @db.Char(64)
  platform      DevicePlatform
  appVersion    String         @map("app_version") @db.VarChar(20)
  language      AppLanguage    @default(en)
  role          DeviceRole     @default(public)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt    DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@map("devices")
}

/// Rotating refresh tokens, stored as SHA-256 hashes. Every token in a login
/// chain shares a familyId so a reused (stolen) token can revoke the whole chain.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  deviceId  String    @map("device_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Append-only record of security-relevant actions, written by event listeners.
model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  deviceId      String?  @map("device_id") @db.Uuid
  action        String   @db.VarChar(64)
  entity        String?  @db.VarChar(64)
  entityId      String?  @map("entity_id") @db.VarChar(64)
  meta          Json     @default("{}")
  correlationId String?  @map("correlation_id") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([deviceId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}
