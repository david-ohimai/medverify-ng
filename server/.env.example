# Copy to .env (cp .env.example .env) and fill in. Never commit .env.

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# debug in development, info in production
LOG_LEVEL=debug
# Proxy hops in front of the app (Render = 1). 0 when running locally.
TRUST_PROXY=0
# Browser origins allowed by CORS. The mobile app doesn't need CORS; leave empty
# unless a web client is added. Never "*".
CORS_ORIGINS=

# ─── Database (local Docker on port 5433, see docs/database-setup.md) ────────
DATABASE_URL=postgresql://medverify:medverify@localhost:5433/medverify?schema=public
# Read-only user the AI agent's tools will use (week 2)
DATABASE_URL_READONLY=postgresql://medverify_reader:reader@localhost:5433/medverify?schema=public

# ─── Redis (rate limits, cache, queues) ──────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Tokens ──────────────────────────────────────────────────────────────────
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ─── Regulator mode ──────────────────────────────────────────────────────────
# PIN that unlocks regulator mode in the app (6-12 digits).
REGULATOR_DEMO_PIN=246810

# ─── Observability ───────────────────────────────────────────────────────────
# When set, GET /metrics requires "Authorization: Bearer <METRICS_TOKEN>".
METRICS_TOKEN=
# Serve Swagger UI at /api-docs (defaults to on outside production).
SWAGGER_ENABLED=true

# ─── AI providers (free tiers only, see docs/server-setup.md, "AI layer") ───
# Without any key the server still runs; photo scans answer 503 AI_UNAVAILABLE.
LLM_PRIMARY=gemini
# Second provider when the first is rate-limited, down, or out of today's budget. "none" to disable.
LLM_FALLBACK=openrouter
# Hard deadline per AI attempt (ms). Vision calls normally take 5-15 s.
LLM_TIMEOUT_MS=30000

# Google AI Studio → Get API key (free, no card): https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.5-flash
GEMINI_LIGHT_MODEL=gemini-3.5-flash-lite
# Our own daily cap, kept below the free tier's, so scans stop cleanly instead of failing.
GEMINI_DAILY_LIMIT=200

# Optional fallback. openrouter.ai → Keys. Only free models (ids ending in :free).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_DAILY_LIMIT=45

# Run the background workers (scan pipeline + hotspot clustering) inside the API process.
# Set false when running `npm run worker` separately.
SCAN_WORKER_ENABLED=true
