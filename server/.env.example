# Copy to .env (cp .env.example .env) and fill in. Never commit .env.

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# debug in development, info in production
LOG_LEVEL=debug
# Proxy hops in front of the app (Render = 1). 0 when running locally.
TRUST_PROXY=0
# Browser origins allowed by CORS. The mobile app doesn't need CORS; leave empty
# unless a web client is added. Never "*".
CORS_ORIGINS=

# ─── Database (local Docker on port 5433 — see docs/database-setup.md) ────────
DATABASE_URL=postgresql://medverify:medverify@localhost:5433/medverify?schema=public
# Read-only user the AI agent's tools will use (week 2)
DATABASE_URL_READONLY=postgresql://medverify_reader:reader@localhost:5433/medverify?schema=public

# ─── Redis (rate limits, cache, queues) ──────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Tokens ──────────────────────────────────────────────────────────────────
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ─── Regulator mode ──────────────────────────────────────────────────────────
# PIN that unlocks regulator mode in the app (6-12 digits).
REGULATOR_DEMO_PIN=246810

# ─── Observability ───────────────────────────────────────────────────────────
# When set, GET /metrics requires "Authorization: Bearer <METRICS_TOKEN>".
METRICS_TOKEN=
# Serve Swagger UI at /api-docs (defaults to on outside production).
SWAGGER_ENABLED=true
