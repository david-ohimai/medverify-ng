# Store and check out text files with LF everywhere (Linux CI runners and
# Docker need LF; Windows editors handle it fine). Silences the CRLF warnings.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never touch line endings.
*.png binary
*.jpg binary
*.otf binary
*.ttf binary
*.jar binary
